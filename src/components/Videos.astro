---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import videos from '../data/videos.json';
import cover from '../assets/demo/cover.jpg';
import plan from '../assets/demo/plan.jpg';
import t4 from '../assets/demo/table-4.jpg';

type Video = { slug: string; order: number; title: string; description: string; duration: string; poster: string; src: string; youtube: string };
const list = videos as Video[];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ytId = (url: string) => url.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/)?.[1] ?? '';

// Пока роликов нет — три карточки-плейсхолдера (см. TODO.md).
const placeholders = [cover, plan, t4];
---
<section class="section" id="videos" aria-labelledby="videos-title">
  <div class="container">
    <SectionHeading eyebrow="Обучающие ролики" id="videos-title">
      Как работать <span class="accent">с&nbsp;MESTO</span>
      <Fragment slot="lead">Обучающие видео о работе с MESTO. Ролик загружается только после нажатия на карточку.</Fragment>
    </SectionHeading>

    <ul class="vids">
      {list.length > 0 && list.map((v, i) => {
        const id = ytId(v.youtube);
        const ready = Boolean(v.src || id);
        return (
          <li class="reveal" style={`--d:${i * 0.08}s`}>
            <button
              type="button"
              class="vid"
              data-video
              data-title={v.title}
              data-src={v.src ? `${base}/${v.src}` : ''}
              data-poster={`${base}/${v.poster}`}
              data-youtube={id}
              aria-disabled={ready ? undefined : 'true'}
              aria-label={`Смотреть ролик: ${v.title}${v.duration ? `, ${v.duration}` : ''}`}
            >
              <span class="vid__media">
                <img src={`${base}/${v.poster}`} alt="" loading="lazy" decoding="async" width="1280" height="720" />
                <span class="vid__play" aria-hidden="true"></span>
                {v.duration && <span class="vid__dur">{v.duration}</span>}
              </span>
              <span class="vid__n">Ролик {String(i + 1).padStart(2, '0')}</span>
              <span class="vid__t">{v.title}</span>
              {v.description && <span class="vid__d">{v.description}</span>}
              {!ready && <span class="placeholder">[ССЫЛКА YOUTUBE]</span>}
            </button>
          </li>
        );
      })}
      {list.length === 0 && placeholders.map((img, i) => (
        <li class="reveal" style={`--d:${i * 0.08}s`}>
          <div class="vid vid--empty" data-video aria-disabled="true">
            <span class="vid__media">
              <Image src={img} alt="" widths={[400, 640]} sizes="(min-width: 1100px) 400px, 90vw" quality={50} />
              <span class="vid__play" aria-hidden="true"></span>
              <span class="vid__dur">—:—</span>
            </span>
            <span class="vid__n">Ролик {String(i + 1).padStart(2, '0')}</span>
            <span class="vid__t"><span class="placeholder">[НАЗВАНИЕ РОЛИКА]</span></span>
            <span class="vid__d">Скоро здесь появится обучающее видео.</span>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="modal" data-modal aria-labelledby="modal-title">
    <div class="modal__box">
      <header class="modal__head">
        <h3 class="modal__title" id="modal-title" data-modal-title></h3>
        <button type="button" class="modal__close" data-modal-close aria-label="Закрыть видео">
          <span aria-hidden="true"></span>
        </button>
      </header>
      <div class="modal__player" data-modal-player></div>
    </div>
  </dialog>
</section>

<style>
  .vids { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 0.5rem + 1.5vw, 2rem); }
  .vid {
    width: 100%; height: 100%; display: grid; gap: 0.6rem; align-content: start; padding: 0; text-align: left;
    background: none; border: 0; cursor: pointer; color: inherit;
  }
  .vid__media {
    position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-lg);
    background: var(--bg-3); border: 1px solid var(--line); margin-bottom: 0.6rem;
  }
  .vid__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease), opacity 0.6s; }
  .vid__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(21,16,13,.7)); }
  .vid:hover .vid__media :global(img) { transform: scale(1.05); }
  .vid__play {
    position: absolute; z-index: 1; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%;
    background: rgba(21, 16, 13, 0.6); border: 1px solid rgba(243, 233, 220, 0.5);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); transition: transform 0.5s var(--ease), background-color 0.3s;
  }
  .vid__play::after { content: ''; position: absolute; left: 26px; top: 21px; border-style: solid; border-width: 11px 0 11px 17px; border-color: transparent transparent transparent var(--cream); }
  .vid:hover .vid__play { transform: scale(1.1); background: var(--brick); border-color: var(--brick); }
  .vid__dur { position: absolute; z-index: 1; right: 0.75rem; bottom: 0.75rem; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; background: rgba(21,16,13,.8); font-variant-numeric: tabular-nums; }
  .vid__n { font-size: var(--fs-eyebrow); font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--amber); }
  .vid__t { font-family: var(--ff-display); font-size: var(--fs-h3); line-height: 1.15; }
  .vid__d { color: var(--cream-2); font-size: 0.9375rem; }
  .vid__t .placeholder { font-size: 0.875rem; padding: 0.2em 0.6em; }
  .vid--empty, .vid[aria-disabled='true'] { cursor: default; }
  .vid--empty .vid__media :global(img) { opacity: 0.4; }
  .vid--empty:hover .vid__media :global(img) { transform: none; }
  .vid--empty:hover .vid__play { transform: none; background: rgba(21, 16, 13, 0.6); border-color: rgba(243, 233, 220, 0.5); }
  @media (max-width: 899px) { .vids { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 599px) { .vids { grid-template-columns: 1fr; } }

  /* ---------- модальное окно ---------- */
  .modal {
    width: min(1100px, 100vw - 2 * var(--gutter)); max-width: none; max-height: none; padding: 0; border: 0;
    background: transparent; color: var(--cream); overflow: visible;
  }
  .modal::backdrop { background: rgba(10, 7, 5, 0.88); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .modal[open] { animation: modalIn 0.5s var(--ease); }
  .modal[open]::backdrop { animation: fadeIn 0.4s ease; }
  @keyframes modalIn { from { opacity: 0; transform: translateY(20px) scale(0.98); } }
  @keyframes fadeIn { from { opacity: 0; } }
  .modal__box { display: grid; gap: 0.9rem; }
  .modal__head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .modal__title { font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem); }
  .modal__close {
    position: relative; flex: none; width: 48px; height: 48px; border-radius: 50%; cursor: pointer;
    background: rgba(243, 233, 220, 0.08); border: 1px solid var(--line-strong); transition: background-color 0.3s, transform 0.4s var(--ease);
  }
  .modal__close:hover { background: var(--brick); transform: rotate(90deg); }
  .modal__close span::before, .modal__close span::after { content: ''; position: absolute; left: 50%; top: 50%; width: 18px; height: 1.5px; margin: -0.75px 0 0 -9px; background: var(--cream); transform: rotate(45deg); }
  .modal__close span::after { transform: rotate(-45deg); }
  .modal__player { position: relative; aspect-ratio: 16 / 9; max-height: calc(100svh - 9rem); background: #000; border-radius: var(--radius-lg); overflow: hidden; }
  .modal__player :global(video), .modal__player :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: contain; }
</style>

<script>
  import '../scripts/modal';
</script>
