---
import { Picture } from 'astro:assets';
import cover from '../assets/demo/cover.jpg';
import Button from './Button.astro';
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__media" data-parallax>
    <Picture
      src={cover}
      alt="Зал ресторана: кирпичная стена с камином, арочные окна, деревянные столы и барная стойка в тёплом вечернем свете"
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      formats={['avif', 'webp']}
      quality={62}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero__img"
    />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__content">
    <p class="eyebrow hero__in" style="--d:.1s">Ваш ресторан. Ваши гости. Всё под контролем.</p>
    <h1 class="h1 hero__title hero__in" id="hero-title" style="--d:.2s">
      Гость выбирает стол —<br class="hide-sm" /> и&nbsp;заранее видит, <span class="accent">как будет сидеть</span>
    </h1>
    <p class="lead hero__lead hero__in" style="--d:.35s">
      MESTO показывает зал сверху и&nbsp;панораму с&nbsp;каждого стола. Гость выбирает место у&nbsp;окна, диван или тихий угол и&nbsp;бронирует его онлайн — без звонков и&nbsp;переписки.
    </p>
    <div class="btn-row hero__in" style="--d:.5s">
      <Button href="#demo" size="lg">Смотреть демо</Button>
      <Button href="#contact" variant="ghost" size="lg">Подключить ресторан</Button>
    </div>
  </div>

  <a href="#problem" class="hero__scroll" aria-label="Листать дальше">
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative; min-height: 100svh; display: flex; align-items: flex-end;
    padding-block: calc(var(--header-h) + 3rem) clamp(4rem, 3rem + 5vw, 8rem);
    overflow: hidden; isolation: isolate;
  }
  .hero__media { position: absolute; inset: -6% 0 -6%; z-index: -2; will-change: transform; }
  .hero__media :global(picture), .hero__media :global(img) { width: 100%; height: 100%; }
  .hero__media :global(img) { object-fit: cover; object-position: 50% 55%; animation: heroZoom 2.4s var(--ease) both; }
  .hero__shade {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgba(21,16,13,.7) 0%, rgba(21,16,13,.25) 30%, rgba(21,16,13,.55) 62%, rgba(21,16,13,.97) 100%),
      radial-gradient(120% 80% at 15% 100%, rgba(21,16,13,.75), transparent 60%);
  }
  .hero__content { display: grid; gap: 1.5rem; }
  .hero__title { max-width: 17ch; text-shadow: 0 2px 30px rgba(0,0,0,.35); }
  .hero__lead { color: var(--cream); opacity: 0.92; max-width: 34rem; }
  .hero .btn-row { margin-top: 0.75rem; }

  .hero__in { opacity: 0; transform: translateY(24px); animation: heroIn 1.1s var(--ease) var(--d, 0s) both; }
  @keyframes heroIn { to { opacity: 1; transform: none; } }
  @keyframes heroZoom { from { transform: scale(1.08); } to { transform: none; } }

  .hero__scroll {
    position: absolute; right: var(--gutter); bottom: clamp(4rem, 3rem + 5vw, 8rem);
    width: 44px; height: 72px; display: grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 999px;
  }
  .hero__scroll span { width: 1px; height: 24px; background: var(--cream); transform-origin: top; animation: scrollCue 2.2s var(--ease-in-out) infinite; }
  @keyframes scrollCue { 0% { transform: scaleY(0); opacity: 1; } 60% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1) translateY(10px); opacity: 0; } }
  @media (max-width: 767px) { .hero__scroll { display: none; } .hero .btn-row :global(.btn) { flex: 1 1 100%; } }
  @media (prefers-reduced-motion: reduce) { .hero__in { opacity: 1; transform: none; } }
</style>

<script>
  const media = document.querySelector<HTMLElement>('[data-parallax]');
  if (media && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const y = window.scrollY;
      if (y < window.innerHeight * 1.2) media.style.transform = `translate3d(0, ${y * 0.18}px, 0)`;
    };
    window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
  }
</script>
