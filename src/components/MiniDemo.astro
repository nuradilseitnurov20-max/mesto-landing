---
import { Picture, getImage } from 'astro:assets';
import plan from '../assets/demo/plan.jpg';
import t1 from '../assets/demo/table-1.jpg';
import t2 from '../assets/demo/table-2.jpg';
import t3 from '../assets/demo/table-3.jpg';
import t4 from '../assets/demo/table-4.jpg';
import t5 from '../assets/demo/table-5.jpg';
import SectionHeading from './SectionHeading.astro';
import { site, isPlaceholder } from '../data/site';

// Метки столов в % от ширины/высоты plan.jpg
const tables = [
  { n: 1, x: 31.9, y: 25.9, seats: '2 места', kind: 'у окна', img: t1 },
  { n: 2, x: 46.2, y: 25.9, seats: '4 места', kind: 'у окна', img: t2 },
  { n: 3, x: 61.0, y: 25.9, seats: '2 места', kind: 'у окна', img: t3 },
  { n: 4, x: 23.2, y: 53.5, seats: '4 места', kind: 'кабинка', img: t4 },
  { n: 5, x: 46.1, y: 49.7, seats: '6 мест', kind: 'общий стол', img: t5 },
];

const panoWidths = [1400, 2000, 2800];
const data = await Promise.all(
  tables.map(async (t) => {
    const set = await Promise.all(panoWidths.map((w) => getImage({ src: t.img, width: w, format: 'webp', quality: 66 })));
    return {
      n: t.n, x: t.x, y: t.y,
      label: `Стол ${t.n} · ${t.kind}, ${t.seats}`,
      src: set[1].src,
      srcset: set.map((s, i) => `${s.src} ${panoWidths[i]}w`).join(', '),
      ratio: t.img.width / t.img.height,
    };
  }),
);
const blur = await getImage({ src: plan, width: 64, format: 'webp', quality: 50 });
const demoReady = !isPlaceholder(site.demoUrl);
---
<section class="section demo-sec" id="demo" aria-labelledby="demo-title">
  <div class="container">
    <SectionHeading eyebrow="Мини-демо" id="demo-title">
      Как это видит <span class="accent">гость</span>
      <Fragment slot="lead">Нажмите на любой стол: камера приблизится и откроется вид с этого места. Панораму можно осматривать — тяните её мышью или пальцем.</Fragment>
    </SectionHeading>

    <div class="demo reveal" data-demo data-tables={JSON.stringify(data)} data-overflow-ok>
      <div class="demo__stage" data-stage>
        <div class="demo__plan" data-plan>
          <Picture
            src={plan}
            alt="Демо-ресторан сверху: три стола у арочных окон, кабинка у кирпичной стены с камином, общий стол в центре, барная стойка справа"
            widths={[800, 1280, 1800, 2400]}
            sizes="(min-width: 1340px) 1240px, (max-width: 599px) 180vw, 100vw"
            formats={['avif', 'webp']}
            quality={60}
            class="demo__planimg"
            draggable="false"
          />
          <img class="demo__blur" src={blur.src} alt="" aria-hidden="true" width="64" height="36" draggable="false" />
          <ul class="demo__pins" aria-label="Столы на плане зала">
            {data.map((t) => (
              <li style={`left:${t.x}%;top:${t.y}%`}>
                <button class="pin" type="button" data-open={t.n} aria-label={`Открыть вид с места: ${t.label}`}>
                  <span class="pin__dot" aria-hidden="true">{t.n}</span>
                  <span class="pin__tip" aria-hidden="true">{t.label}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>

        <div class="demo__pano" data-pano hidden>
          <div class="demo__track" data-track tabindex="0" role="group" aria-roledescription="панорама" aria-label="Панорама. Перетаскивайте или используйте стрелки влево и вправо">
            <img class="demo__panoimg" data-panoimg alt="" draggable="false" decoding="async" />
          </div>
          <div class="demo__hud">
            <button class="demo__back" type="button" data-back>
              <span aria-hidden="true">←</span> Назад к залу
            </button>
            <p class="demo__label" data-label aria-live="polite"></p>
          </div>
          <div class="demo__hint" data-hint aria-hidden="true">
            <span class="demo__hand"></span> Потяните, чтобы осмотреться
          </div>
          <div class="demo__arrows">
            <button type="button" data-step="-1" aria-label="Повернуть влево">‹</button>
            <button type="button" data-step="1" aria-label="Повернуть вправо">›</button>
          </div>
        </div>

        <div class="demo__loader" data-loader aria-hidden="true"></div>
      </div>

      <div class="demo__bar">
        <ul class="demo__chips" aria-label="Выбрать стол">
          {data.map((t) => (
            <li><button type="button" class="chip" data-open={t.n}>{t.label}</button></li>
          ))}
        </ul>
        {demoReady ? (
          <a class="btn btn--ghost" href={site.demoUrl} target="_blank" rel="noopener"><span class="btn__label">Открыть полное демо</span><span class="btn__arrow" aria-hidden="true">↗</span></a>
        ) : (
          <span class="btn btn--ghost demo__full" aria-disabled="true"><span class="btn__label">Полное демо: <span class="placeholder">{site.demoUrl}</span></span></span>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .demo-sec { background: radial-gradient(70% 50% at 50% 0%, rgba(165, 70, 46, 0.14), transparent 70%), var(--bg); }

  .demo {
    --pw: 100%; --pl: 0%;
    position: relative;
  }
  .demo__stage {
    position: relative; aspect-ratio: 2720 / 1536; overflow: hidden; border-radius: var(--radius-lg);
    background: #0c0907; border: 1px solid var(--line-strong);
    box-shadow: 0 40px 120px -40px rgba(0, 0, 0, 0.8);
    touch-action: pan-y; user-select: none; -webkit-user-select: none;
  }
  .demo__stage::after {
    content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 3;
    box-shadow: inset 0 0 120px rgba(0, 0, 0, 0.55); border-radius: inherit;
  }

  /* --- план --- */
  .demo__plan {
    position: absolute; top: 0; left: var(--pl); width: var(--pw); height: 100%;
    transform-origin: 0 0; will-change: transform;
    transition: transform 1.1s var(--ease-in-out);
  }
  .demo__plan :global(picture), .demo__plan :global(.demo__planimg) { width: 100%; height: 100%; }
  .demo__plan :global(.demo__planimg) { object-fit: cover; pointer-events: none; }
  .demo__blur {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0;
    transform: scale(1.02); transition: opacity 0.45s ease; pointer-events: none;
  }
  .demo.is-blur .demo__blur { opacity: 1; }

  .demo__pins { list-style: none; position: absolute; inset: 0; transition: opacity 0.3s; }
  .demo__pins li { position: absolute; width: 0; height: 0; }
  .demo.is-zoom .demo__pins { opacity: 0; pointer-events: none; }

  .pin {
    position: absolute; left: -24px; top: -24px; width: 48px; height: 48px; padding: 0;
    display: grid; place-items: center; background: none; border: 0; cursor: pointer;
  }
  .pin__dot {
    position: relative; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center;
    font-size: 0.8125rem; font-weight: 600; color: var(--bg); background: var(--amber);
    box-shadow: 0 0 0 3px rgba(21, 16, 13, 0.85), 0 6px 18px rgba(0, 0, 0, 0.6);
    transition: transform 0.4s var(--ease), background-color 0.3s;
  }
  .pin__dot::before, .pin__dot::after {
    content: ''; position: absolute; inset: -3px; border-radius: 50%; border: 1.5px solid var(--amber);
    animation: pinPulse 2.4s var(--ease) infinite;
  }
  .pin__dot::after { animation-delay: 1.2s; }
  .pin:hover .pin__dot, .pin:focus-visible .pin__dot { transform: scale(1.15); background: var(--cream); }
  .pin:focus-visible { outline: none; }
  .pin:focus-visible .pin__dot { box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--amber); }
  .pin__tip {
    position: absolute; bottom: calc(100% + 2px); left: 50%; white-space: nowrap;
    padding: 0.4rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600;
    background: rgba(21, 16, 13, 0.9); color: var(--cream); border: 1px solid var(--line-strong);
    opacity: 0; transform: translate(-50%, 6px); transition: opacity 0.3s, transform 0.4s var(--ease); pointer-events: none;
  }
  .pin:hover .pin__tip, .pin:focus-visible .pin__tip { opacity: 1; transform: translate(-50%, 0); }

  /* --- панорама --- */
  .demo__pano { position: absolute; inset: 0; z-index: 2; opacity: 0; transition: opacity 0.6s ease; }
  .demo__pano[hidden] { display: none; }
  .demo.is-pano .demo__pano { opacity: 1; }
  .demo__track { position: absolute; inset: 0; cursor: grab; outline: none; }
  .demo__track:active { cursor: grabbing; }
  .demo__track:focus-visible { box-shadow: inset 0 0 0 2px var(--amber); }
  .demo__panoimg {
    position: absolute; top: 0; left: 0; height: 100%; width: auto; max-width: none;
    will-change: transform; transform: scale(1.06); transition: transform 0.9s var(--ease);
    pointer-events: none;
  }

  .demo__hud {
    position: absolute; z-index: 4; top: 1rem; left: 1rem; right: 1rem;
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem; pointer-events: none;
  }
  .demo__back, .demo__label, .demo__arrows button {
    pointer-events: auto; border-radius: 999px; background: rgba(21, 16, 13, 0.78); border: 1px solid var(--line-strong);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); color: var(--cream);
  }
  .demo__back { min-height: 44px; padding: 0.55rem 1.1rem; font-size: 0.875rem; font-weight: 600; cursor: pointer; transition: background-color 0.3s, transform 0.3s var(--ease); }
  .demo__back:hover { background: var(--brick); }
  .demo__label { padding: 0.55rem 1rem; font-size: 0.8125rem; }
  .demo__arrows { position: absolute; z-index: 4; right: 1rem; bottom: 1rem; display: flex; gap: 0.5rem; }
  .demo__arrows button { width: 44px; height: 44px; font-size: 1.4rem; line-height: 1; cursor: pointer; transition: background-color 0.3s; }
  .demo__arrows button:hover { background: var(--brick); }

  .demo__hint {
    position: absolute; z-index: 4; left: 50%; bottom: 1.25rem; transform: translateX(-50%);
    display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 1rem; border-radius: 999px;
    background: rgba(21, 16, 13, 0.78); font-size: 0.8125rem; white-space: nowrap; pointer-events: none;
    transition: opacity 0.5s;
  }
  .demo__hint.is-gone { opacity: 0; }
  .demo__hand { width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid var(--amber); animation: hintSwipe 1.8s var(--ease-in-out) infinite; }
  @keyframes hintSwipe { 0%, 100% { transform: translateX(-6px); } 50% { transform: translateX(6px); } }

  .demo__loader {
    position: absolute; z-index: 5; left: 50%; top: 50%; width: 36px; height: 36px; margin: -18px 0 0 -18px;
    border-radius: 50%; border: 2px solid rgba(243, 233, 220, 0.2); border-top-color: var(--amber);
    opacity: 0; transition: opacity 0.3s; animation: spin 0.9s linear infinite; pointer-events: none;
  }
  .demo.is-loading .demo__loader { opacity: 1; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* --- нижняя панель --- */
  .demo__bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem 2rem; margin-top: 1.5rem; }
  .demo__chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    min-height: 40px; padding: 0.5rem 0.95rem; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent;
    font-size: 0.8125rem; color: var(--cream-2); cursor: pointer; transition: border-color 0.3s, color 0.3s, background-color 0.3s;
  }
  .chip:hover { border-color: var(--amber); color: var(--cream); }
  .chip[aria-pressed='true'] { background: var(--amber); border-color: var(--amber); color: var(--bg); }
  .demo__full { cursor: default; }
  .demo__full::before { display: none; }

  @media (max-width: 899px) {
    .demo { --pw: 132.8%; --pl: -5.8%; }
    .demo__stage { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 599px) {
    .demo { --pw: 177.1%; --pl: -24.4%; }
    .demo__stage { aspect-ratio: 1 / 1; border-radius: 10px; }
    .demo__chips { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scrollbar-width: none; }
    .demo__chips::-webkit-scrollbar { display: none; }
    .chip { white-space: nowrap; }
    .demo__bar { margin-top: 1rem; }
    .demo__hud { top: 0.75rem; left: 0.75rem; right: 0.75rem; }
    .demo__label { display: none; }
    .demo__arrows { right: 0.75rem; bottom: 0.75rem; }
    .demo__hint { bottom: 4.25rem; }
    .demo__full { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo__plan, .demo__panoimg { transition: none; }
  }
</style>

<script>
  import '../scripts/demo';
</script>
