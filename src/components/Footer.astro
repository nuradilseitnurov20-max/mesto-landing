---
import Logo from './Logo.astro';
import { nav } from '../data/nav';
import { site } from '../data/site';
---
<footer class="ftr">
  <div class="container ftr__top">
    <div class="ftr__brand">
      <Logo />
      <p class="ftr__tag">MESTO — новый уровень взаимодействия с&nbsp;гостями.</p>
    </div>
    <nav aria-label="Навигация в подвале">
      <ul class="ftr__list">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <ul class="ftr__list">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.whatsappConnect} target="_blank" rel="noopener">WhatsApp: подключение</a></li>
      <li><a href={site.whatsappPartner} target="_blank" rel="noopener">WhatsApp: сотрудничество</a></li>
    </ul>
  </div>
  <div class="container ftr__bottom">
    <p>MESTO © 2026</p>
    <p>Алматы, Казахстан</p>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--line); padding-top: clamp(3.5rem, 2.5rem + 3vw, 5rem); background: var(--bg); }
  .ftr__top { display: grid; gap: 2.5rem; grid-template-columns: 1.4fr 1fr 1fr; padding-bottom: 3rem; }
  .ftr__tag { margin-top: 1.25rem; max-width: 22rem; font-family: var(--ff-display); font-size: 1.5rem; line-height: 1.25; color: var(--cream-2); }
  .ftr__list { list-style: none; display: grid; gap: 0.6rem; align-content: start; font-size: 0.9375rem; }
  .ftr__list a { color: var(--cream-2); text-decoration: none; transition: color 0.3s; display: inline-block; padding-block: 0.2rem; }
  .ftr__list a:hover { color: var(--amber); }
  .ftr__bottom { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.5rem; border-top: 1px solid var(--line); font-size: 0.8125rem; color: var(--muted); }
  @media (max-width: 767px) { .ftr__top { grid-template-columns: 1fr; } }
</style>
