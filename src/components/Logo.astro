---
import { site } from '../data/site';
interface Props { class?: string; dark?: boolean }
const { class: cls = '', dark = false } = Astro.props;
---
<a href="#top" class:list={['logo', dark && 'logo--dark', cls]} aria-label={`${site.name} — наверх`}>
  <svg class="logo__mark" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="currentColor"/><path d="M19 43V22l13 13 13-13v21" fill="none" stroke="#c7deb4" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <span class="logo__word">{site.name}</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--green); }
  .logo__mark { width: 34px; height: 34px; transition: transform 0.6s var(--ease); }
  .logo:hover .logo__mark { transform: rotate(-8deg); }
  .logo__word { font-weight: 700; font-size: 1.125rem; letter-spacing: 0.14em; }
  .logo--dark { color: var(--on-dark); }
  .logo--dark .logo__mark { color: var(--green-3); }
</style>
