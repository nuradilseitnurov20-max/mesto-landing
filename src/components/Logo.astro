---
import { site } from '../data/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href="#top" class:list={['logo', cls]} aria-label={`${site.name} — наверх`}>
  <svg class="logo__mark" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="none" stroke="currentColor" stroke-width="2.5" opacity=".55"/><path d="M19 43V22l13 13 13-13v21" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <span class="logo__word">{site.name}</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none; color: var(--cream); }
  .logo__mark { width: 30px; height: 30px; color: var(--amber); transition: transform 0.6s var(--ease); }
  .logo:hover .logo__mark { transform: rotate(-12deg); }
  .logo__word { font-family: var(--ff-text); font-weight: 600; font-size: 1rem; letter-spacing: 0.32em; margin-right: -0.32em; }
</style>
