---
import Button from './Button.astro';
import { site } from '../data/site';
---
<section class="section section--alt" id="pricing" aria-labelledby="price-title">
  <div class="container">
    <div class="price reveal">
      <div>
        <p class="eyebrow">Стоимость</p>
        <h2 class="h2 price__t" id="price-title">Стоимость&nbsp;— <span class="accent">по&nbsp;запросу</span></h2>
      </div>
      <div class="price__side">
        <p class="lead">Расскажите о вашем заведении: зал, количество столов, где вы принимаете брони сейчас. Ответим в WhatsApp или на почту.</p>
        <div class="btn-row">
          <Button href={site.whatsappConnect} external>Узнать стоимость в WhatsApp</Button>
          <Button href={`mailto:${site.email}?subject=MESTO%20—%20стоимость`} variant="text">Написать на почту</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .price {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 4rem; align-items: end;
    padding: clamp(2rem, 1rem + 4vw, 4.5rem); border-radius: var(--radius-lg); border: 1px solid var(--line-strong);
    background: radial-gradient(90% 120% at 0% 0%, rgba(217,160,91,.12), transparent 55%), radial-gradient(80% 100% at 100% 100%, rgba(165,70,46,.2), transparent 60%), var(--bg);
  }
  .price__t { margin-top: 1.25rem; }
  .price__side { display: grid; gap: 1.75rem; }
  @media (max-width: 899px) { .price { grid-template-columns: 1fr; } }
</style>
