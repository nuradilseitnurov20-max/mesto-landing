---
import { site, isPlaceholder, telegramUrl } from '../data/site';
import Icon from './Icon.astro';

const tgReady = !isPlaceholder(site.telegram);
const [mailUser, mailHost] = site.email.split('@');
---
<section class="section contact-sec" id="contact" aria-labelledby="cta-title">
  <div class="container">
    <div class="cbox">
      <div class="cbox__text">
        <p class="eyebrow reveal">Контакты</p>
        <h2 class="h2 cbox__t reveal" id="cta-title" style="--d:.08s">Начните работать <span class="cbox__accent">с&nbsp;MESTO</span></h2>
        <p class="lead reveal" style="--d:.16s">Создайте современный цифровой опыт для своих гостей и упростите ежедневную работу ресторана.</p>
        <div class="btn-row reveal" style="--d:.24s">
          <a class="btn btn--lime btn--lg" href={site.whatsappConnect} target="_blank" rel="noopener"><span class="btn__label">Подключить через WhatsApp</span><span class="btn__arrow" aria-hidden="true">→</span></a>
        </div>
      </div>

      <ul class="cbox__list reveal" style="--d:.2s">
        <li>
          <a class="cl" href={site.whatsappConnect} target="_blank" rel="noopener">
            <span class="cl__ico"><Icon name="chat" /></span>
            <span class="cl__body"><span class="cl__k">WhatsApp · подключение</span><span class="cl__v">Подключить MESTO</span></span>
            <span class="cl__arr" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a class="cl" href={site.whatsappPartner} target="_blank" rel="noopener">
            <span class="cl__ico"><Icon name="users" /></span>
            <span class="cl__body"><span class="cl__k">WhatsApp · сотрудничество</span><span class="cl__v">Обсудить сотрудничество</span></span>
            <span class="cl__arr" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a class="cl" href={`mailto:${site.email}?subject=MESTO%20—%20заявка`}>
            <span class="cl__ico"><Icon name="mail" /></span>
            <span class="cl__body"><span class="cl__k">E-mail</span><span class="cl__v cl__v--mail">{mailUser}<wbr />@{mailHost}</span></span>
            <span class="cl__arr" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          {tgReady ? (
            <a class="cl" href={telegramUrl(site.telegram)} target="_blank" rel="noopener">
              <span class="cl__ico"><Icon name="send" /></span>
              <span class="cl__body"><span class="cl__k">Telegram</span><span class="cl__v">{site.telegram}</span></span>
              <span class="cl__arr" aria-hidden="true">↗</span>
            </a>
          ) : (
            <div class="cl cl--off">
              <span class="cl__ico"><Icon name="send" /></span>
              <span class="cl__body"><span class="cl__k">Telegram</span><span class="cl__v"><span class="placeholder">{site.telegram}</span></span></span>
            </div>
          )}
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-sec { padding-top: 0; }
  .cbox {
    position: relative; overflow: hidden; isolation: isolate;
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(2rem, 1rem + 3vw, 4rem); align-items: center;
    padding: clamp(2rem, 1rem + 4vw, 4.5rem); border-radius: var(--r-lg); background: var(--green); color: var(--on-dark);
  }
  .cbox::before { content: ''; position: absolute; width: 520px; aspect-ratio: 1; left: -180px; bottom: -280px; border-radius: 50%; background: radial-gradient(circle, rgba(199, 222, 180, 0.22), transparent 65%); z-index: -1; }
  .cbox .eyebrow { background: rgba(199, 222, 180, 0.16); color: var(--lime); }
  .cbox__text { display: grid; gap: 1.25rem; justify-items: start; }
  .cbox__t { font-size: clamp(2.2rem, 1.4rem + 3.4vw, 4.25rem); }
  .cbox__accent { color: var(--lime); }
  .cbox .lead { color: var(--on-dark-2); }
  .cbox .btn-row { margin-top: 0.5rem; }

  .cbox__list { list-style: none; display: grid; gap: 0.6rem; }
  .cl {
    position: relative; display: flex; align-items: center; gap: 1rem; padding: 1rem 3rem 1rem 1rem; border-radius: var(--r);
    background: rgba(246, 244, 237, 0.06); border: 1px solid var(--line-dark); color: var(--on-dark); text-decoration: none;
    transition: background-color 0.3s, transform 0.45s var(--ease), border-color 0.3s;
  }
  a.cl:hover { background: rgba(246, 244, 237, 0.12); transform: translateX(4px); border-color: rgba(199, 222, 180, 0.5); }
  .cl__ico { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: var(--lime); color: var(--green); flex: none; }
  .cl__ico :global(svg) { width: 22px; height: 22px; }
  .cl__body { display: grid; gap: 0.1rem; min-width: 0; }
  .cl__k { font-size: 0.8125rem; color: var(--on-dark-2); }
  .cl__v { font-weight: 700; font-size: 1.0625rem; letter-spacing: -0.01em; }
  .cl__v--mail { overflow-wrap: anywhere; }
  .cl__arr { position: absolute; right: 1.2rem; top: 50%; transform: translateY(-50%); color: var(--lime); transition: transform 0.35s var(--ease); }
  a.cl:hover .cl__arr { transform: translate(3px, calc(-50% - 3px)); }
  .cl--off { opacity: 0.8; }
  .cl--off .placeholder { color: var(--lime); }

  @media (max-width: 899px) { .cbox { grid-template-columns: 1fr; } }
  @media (max-width: 599px) { .cbox .btn-row, .cbox .btn-row .btn { width: 100%; } }
</style>
