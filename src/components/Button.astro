---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'text';
  size?: 'md' | 'lg';
  external?: boolean;
  class?: string;
  [key: string]: any;
}
const { href, variant = 'primary', size = 'md', external = false, class: cls = '', ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, size === 'lg' && 'btn--lg', cls].filter(Boolean).join(' ');
const ext = external ? { target: '_blank', rel: 'noopener' } : {};
---
{href ? (
  <a href={href} class={classes} {...ext} {...rest}><span class="btn__label"><slot /></span><span class="btn__arrow" aria-hidden="true">→</span></a>
) : (
  <button type="button" class={classes} {...rest}><span class="btn__label"><slot /></span></button>
)}
